# Zettai（Rust 版）のタスク。
#
# **段を入れる前に「何を守るか」を書き出す。**
# なでしこ3 版では lint が test と完全に重複していたのに、Unit 7 まで
# 気づかず、検査時間の半分を食っていた。守っているものが無い段は入れない。
#
# | 段 | 何を守るか | test と重複するか |
# | :--- | :--- | :--- |
# | fmt    | 体裁。差分を読みやすく保つ                          | しない（test は体裁を見ない） |
# | clippy | 言語の慣用から外れた書き方                          | しない（コンパイルは通るが指摘される書き方がある） |
# | test   | 振る舞い。あわせて型・所有権も（コンパイルするため） | — |
# | cov    | テストが見ていないコード                            | しない（test は「通ったか」しか見ない） |
# | test-db| 保管との往復。**別立て**（下記）                     | しない（test は DB を通らない） |
#
# **4 段とも守るものが違うので、4 段とも入れる。**
#
# **DB を使うテストは `check` に入れない**（Unit 5 のゲート 1）。
# 入れると CI が 26 秒 → 48 秒になり、ローカルで docker が必須になる。
# 別立てにすれば CI では並走するので総時間は増えず、書いている間は
# docker 無しで回せる。**代わりに、DB の検査を忘れない仕組みが要る**ので
# `check-all` に入れてある。

# カバレッジの下限。**Unit 3 で見直した。**
#
# Unit 1 では Kotlin 版の kover と揃えて 80 に置いた。段階が 2 つになり、
# 測ってみると 2 つのことが分かった。
#
# | | 行 |
# | :--- | :--- |
# | そのまま | 90.83% |
# | `src/bin/` を除く | **96.35%** |
#
# `src/bin/` は配線だけで、分岐が無く、サーバを起こさないと通らない。
# **段階を切るたびに 22 行の未到達が増える**ので、下限の意味が薄れていく。
#
# 除いたうえで下限を 90 に上げる。実測 96.35% に対して 6 ポイントの余裕。
cov_min := "90"

# カバレッジから外すもの。**配線だけのファイル。**
cov_skip := "src/bin/"

# devShell の外から呼ばれたら、nix develop を挟んで入り直す。
#
# Kotlin 版は ./gradlew、なでしこ3 版は ./node_modules/.bin/cnako3 と、
# ツールをプロジェクトに取り込んでいるので devShell の外でも動く。
# Rust は rustc も cargo-llvm-cov も取り込めないので、環境ごと入り直す。
#
# 揃えないと、ホストの rustc（別の版）で通って CI で落ちる。
# LLVM_COV も devShell が export するので、外では cov が落ちる。
#
# 判定は Nix が立てる IN_NIX_SHELL。中にいれば prefix は空になり、
# 何も挟まらない（再入のコストは devShell の外から呼んだときだけ）。
repo  := justfile_directory() / '../../..'
shell := 'nix develop ' + repo + '#rust --command'
run   := if env('IN_NIX_SHELL', '') == '' { shell } else { '' }

# タスク一覧を表示する
default:
    @just --list

# 依存指定ではなく 1 行で子レシピを呼ぶ。こうすると再入が 1 回で済む
# （依存のままだと fmt・lint・test がそれぞれ入り直して 3 回になる）。

# 書いている間はこれ
check:
    {{run}} just fmt lint test

# リリース前はこれ（カバレッジと DB を含む）
#
# **CI では check-all を 1 本で回さない。** cov までを `check` ジョブ、
# DB を `db` ジョブに分けて並走させる（Unit 5 のゲート 1）。
check-all:
    {{run}} just fmt lint test cov test-db

# 保管との往復。**docker が要る**（`docker compose up -d zettai-db`）。
test-db:
    {{run}} cargo test -p zettai-step5-http --features db --test persistence

# 体裁を検査する（直さない）
fmt:
    {{run}} cargo fmt --all -- --check

# 体裁を直す
fmt-fix:
    {{run}} cargo fmt --all

# -D warnings で警告をエラーにする。clippy の指摘が設計判断に混ざる
# ことがあるので、押された箇所は README の一覧に記録する。

# 慣用から外れた書き方を見つける
lint:
    {{run}} cargo clippy --all-targets --all-features -- -D warnings

# テストを実行する
test:
    {{run}} cargo test --all

# カバレッジを測り、下限を下回ったら落とす
cov:
    {{run}} cargo llvm-cov --all --ignore-filename-regex '{{cov_skip}}' --fail-under-lines {{cov_min}}

# カバレッジの内訳を見る
cov-report:
    {{run}} cargo llvm-cov --all

# ビルドする
build:
    {{run}} cargo build --all

# 最新の段階を実行する（第 2 章から）
run:
    @echo "第 2 章から使えます"

# 生成物を削除する
clean:
    {{run}} cargo clean
