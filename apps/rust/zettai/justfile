# Zettai（Rust 版）のタスク。
#
# **段を入れる前に「何を守るか」を書き出す。**
# なでしこ3 版では lint が test と完全に重複していたのに、Unit 7 まで
# 気づかず、検査時間の半分を食っていた。守っているものが無い段は入れない。
#
# | 段 | 何を守るか | test と重複するか |
# | :--- | :--- | :--- |
# | fmt    | 体裁。差分を読みやすく保つ                          | しない（test は体裁を見ない） |
# | clippy | 言語の慣用から外れた書き方                          | しない（コンパイルは通るが指摘される書き方がある） |
# | test   | 振る舞い。あわせて型・所有権も（コンパイルするため） | — |
# | cov    | テストが見ていないコード                            | しない（test は「通ったか」しか見ない） |
#
# **4 段とも守るものが違うので、4 段とも入れる。**

# ドメイン層のカバレッジの下限（Kotlin 版の kover と揃える）
cov_min := "80"

# devShell の外から呼ばれたら、nix develop を挟んで入り直す。
#
# Kotlin 版は ./gradlew、なでしこ3 版は ./node_modules/.bin/cnako3 と、
# ツールをプロジェクトに取り込んでいるので devShell の外でも動く。
# Rust は rustc も cargo-llvm-cov も取り込めないので、環境ごと入り直す。
#
# 揃えないと、ホストの rustc（別の版）で通って CI で落ちる。
# LLVM_COV も devShell が export するので、外では cov が落ちる。
#
# 判定は Nix が立てる IN_NIX_SHELL。中にいれば prefix は空になり、
# 何も挟まらない（再入のコストは devShell の外から呼んだときだけ）。
repo  := justfile_directory() / '../../..'
shell := 'nix develop ' + repo + '#rust --command'
run   := if env('IN_NIX_SHELL', '') == '' { shell } else { '' }

# タスク一覧を表示する
default:
    @just --list

# 依存指定ではなく 1 行で子レシピを呼ぶ。こうすると再入が 1 回で済む
# （依存のままだと fmt・lint・test がそれぞれ入り直して 3 回になる）。

# 書いている間はこれ
check:
    {{run}} just fmt lint test

# リリース前と CI はこれ（カバレッジを含む）
check-all:
    {{run}} just fmt lint test cov

# 体裁を検査する（直さない）
fmt:
    {{run}} cargo fmt --all -- --check

# 体裁を直す
fmt-fix:
    {{run}} cargo fmt --all

# -D warnings で警告をエラーにする。clippy の指摘が設計判断に混ざる
# ことがあるので、押された箇所は README の一覧に記録する。

# 慣用から外れた書き方を見つける
lint:
    {{run}} cargo clippy --all-targets --all-features -- -D warnings

# テストを実行する
test:
    {{run}} cargo test --all

# カバレッジを測り、下限を下回ったら落とす
cov:
    {{run}} cargo llvm-cov --all --fail-under-lines {{cov_min}}

# カバレッジの内訳を見る
cov-report:
    {{run}} cargo llvm-cov --all

# ビルドする
build:
    {{run}} cargo build --all

# 最新の段階を実行する（第 2 章から）
run:
    @echo "第 2 章から使えます"

# 生成物を削除する
clean:
    {{run}} cargo clean
