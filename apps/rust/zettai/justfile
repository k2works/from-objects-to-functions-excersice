# Zettai（Rust 版）のタスク。
#
# **段を入れる前に「何を守るか」を書き出す。**
# なでしこ3 版では lint が test と完全に重複していたのに、Unit 7 まで
# 気づかず、検査時間の半分を食っていた。守っているものが無い段は入れない。
#
# | 段 | 何を守るか | test と重複するか |
# | :--- | :--- | :--- |
# | fmt    | 体裁。差分を読みやすく保つ                          | しない（test は体裁を見ない） |
# | clippy | 言語の慣用から外れた書き方                          | しない（コンパイルは通るが指摘される書き方がある） |
# | test   | 振る舞い。あわせて型・所有権も（コンパイルするため） | — |
# | cov    | テストが見ていないコード                            | しない（test は「通ったか」しか見ない） |
#
# **4 段とも守るものが違うので、4 段とも入れる。**

# ドメイン層のカバレッジの下限（Kotlin 版の kover と揃える）
cov_min := "80"

# タスク一覧を表示する
default:
    @just --list

# 書いている間はこれ
check: fmt lint test

# リリース前と CI はこれ（カバレッジを含む）
check-all: fmt lint test cov

# 体裁を検査する（直さない）
fmt:
    cargo fmt --all -- --check

# 体裁を直す
fmt-fix:
    cargo fmt --all

# -D warnings で警告をエラーにする。clippy の指摘が設計判断に混ざる
# ことがあるので、押された箇所は README の一覧に記録する。

# 慣用から外れた書き方を見つける
lint:
    cargo clippy --all-targets --all-features -- -D warnings

# テストを実行する
test:
    cargo test --all

# カバレッジを測り、下限を下回ったら落とす
cov:
    cargo llvm-cov --all --fail-under-lines {{cov_min}}

# カバレッジの内訳を見る
cov-report:
    cargo llvm-cov --all

# ビルドする
build:
    cargo build --all

# 最新の段階を実行する（第 2 章から）
run:
    @echo "第 2 章から使えます"

# 生成物を削除する
clean:
    cargo clean
